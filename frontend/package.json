    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.22.0",
    "eslint-plugin-vue": "^9.3.0",
    "jsdom": "^21.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.2.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",

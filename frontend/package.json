    "events": "^3.3.0",
    "lodash": "^4.17.21",
    "maplibre-gl": "^6.19.0",
    "pinia": "^2.0.28",
    "vue": "^3.4.31",
    "vue-fullpage.js": "^0.2.15",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.1.6",
    "vuetify": "^3.6.11"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@mdi/js": "^7.1.96",
